{{#overrides}}
  @override
{{/overrides}}
  Map<String, Object?> get parameters => <String, Object?>{
{{#parameters}}
{{#optional}}
        if ({{name}} case final {{type}} value) {{{key}}}: value,
{{/optional}}
{{^optional}}
        {{{key}}}: {{{encodeExpr}}},
{{/optional}}
{{/parameters}}
      };
