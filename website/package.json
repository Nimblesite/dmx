{
  "name": "dmx-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run wasm && npm run build && vite preview --port 5173",
    "dev:docs": "eleventy --serve --port 8081",
    "wasm": "node ../scripts/build-wasm.mjs",
    "build": "tsc --noEmit && vite build && eleventy",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^4.1.10",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@11ty/eleventy": "^3.1.6",
    "eleventy-plugin-techdoc": "^0.2.0",
    "mermaid": "^11.16.1",
    "prism-code-editor": "^5.3.0"
  }
}
